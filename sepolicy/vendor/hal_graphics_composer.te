allow hal_graphics_composer_default vendor_displayfeature_device:chr_file { ioctl open read };
# Subscribe to panel events without granting display-control ioctls.
allowxperm hal_graphics_composer_default vendor_displayfeature_device:chr_file ioctl { 0x4407 };
allow hal_graphics_composer_default vendor_hal_citsensorservice_xiaomi_default:binder call;
allow hal_graphics_composer_default vendor_hal_citsensorservice_xiaomi_service:service_manager find;
allow hal_graphics_composer_default vendor_hal_displayfeature_xiaomi_service:service_manager find;
allow hal_graphics_composer_default vendor_hal_displayfeature_xiaomi_default:binder call;
allow hal_graphics_composer_default vendor_sysfs_displayfeature:file { open read write ioctl };

add_service(hal_graphics_composer_default, vendor_hal_hwcextension_xiaomi_service)
add_service(hal_graphics_composer_default, vendor_mistcdisplay_service)
add_service(hal_graphics_composer_default, vendor_miclstc_service)

get_prop(hal_graphics_composer_default, vendor_displayfeature_prop)

hal_client_domain(hal_graphics_composer_default, vendor_hal_displayfeature_xiaomi)
